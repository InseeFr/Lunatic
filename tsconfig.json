{
	"compilerOptions": {
		"module": "CommonJS",
		"target": "ESNext",
		"moduleResolution": "node",
		"lib": ["ESNext", "DOM"],
		"esModuleInterop": true,
		"declaration": true,
		// Do not change or the linking script will stop working
		"outDir": "./dist",
		"sourceMap": true,
		"newLine": "LF",
		"noUnusedParameters": true,
		"incremental": true,
		"strict": true,
		"downlevelIteration": true,
		"jsx": "react-jsx",
		"noFallthroughCasesInSwitch": true,
		"skipLibCheck": true
	},
	"include": ["src", "src/tests/setup.ts"],
	"exclude": [
		"src/stories/",
		"tests/",
		"**/*.test.ts",
		"src/**/*.deno.ts",
		"src/**/*.deno.tsx"
	]
}
